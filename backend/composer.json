{
  "name": "isp-billing/backend",
  "type": "project",
  "description": "Professional ISP billing and network management backend",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "pestphp/pest": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php artisan test",
    "lint": "./vendor/bin/pint --test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
