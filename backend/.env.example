APP_NAME="ISP Billing System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=isp_billing
DB_USERNAME=isp_billing
DB_PASSWORD=change-me

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Never commit real credentials. Integration secrets belong here or in your deployment secret manager.
MIKROTIK_DEFAULT_TIMEOUT=5
MPESA_ENVIRONMENT=sandbox
